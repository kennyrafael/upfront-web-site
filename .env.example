# Where the app lives — every call to action on this page points at it.
#
# **Set this on every deployment.** It is baked into the bundle at build time, and its fallback
# is the app's dev server, so a deploy that forgets it ships a landing page whose every button
# goes to localhost. That is not hypothetical: it was live on upfront-beta.vercel.app until
# 2026-09-26, because this file did not exist and nobody knew the variable was there.
#
# One constant, read once in src/lib/utils/links.ts.
VITE_APP_URL=http://localhost:5173
